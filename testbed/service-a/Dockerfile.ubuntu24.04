# Reviewer M2: the same service on Ubuntu 24.04 LTS with Node.js from the
# distribution, which links the system OpenSSL 3.0 rather than a bundled copy.
# Build with:
#   docker build -f Dockerfile.ubuntu24.04 -t service-a:ubuntu24.04 .
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 3000 9464
CMD [ "node", "index.js" ]
